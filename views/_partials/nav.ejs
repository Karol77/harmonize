<%
  // Aktívna nav položka podľa aktuálnej URL
  const _brand = (typeof BRAND_NAME !== 'undefined' && BRAND_NAME) ? BRAND_NAME : 'Hormonize';
  const _path  = typeof locals.currentPath !== 'undefined' ? locals.currentPath : (locals.req ? locals.req.path : '');
  const isActive = href => _path === href || (_path.startsWith(href) && href !== '/') ? ' active' : '';
%>
<header class="top">
  <div class="topInner">
    <a class="brand" href="/">
      <span class="mark">H</span>
      <span class="brandText">
        <b><%= _brand.toUpperCase() %></b>
        <small>Courses &bull; Offline &amp; Online</small>
      </span>
    </a>

    <nav class="nav">
      <a href="/courses" class="<%= isActive('/courses') %>">Kurzy</a>
      <a href="/contact" class="<%= isActive('/contact') %>">Kontakt</a>
      <a class="pill<%= isActive('/login') %>" href="/login">Prihlásenie</a>
    </nav>
  </div>
</header>
