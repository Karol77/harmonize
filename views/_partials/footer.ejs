<%
  const _brand = (typeof BRAND_NAME !== 'undefined' && BRAND_NAME) ? BRAND_NAME : 'Hormonize';
  const _email = (typeof SUPPORT_EMAIL !== 'undefined' && SUPPORT_EMAIL) ? SUPPORT_EMAIL : 'info@harmonize.sk';
  // Escapuj email pre href atribút (ochrana pred špeciálnymi znakmi)
  const _emailHref = encodeURIComponent(_email).replace(/%40/g, '@');
%>
<footer class="footer">
  <div class="footerInner">
    <div class="footCol">
      <b><%= _brand %></b>
      <div class="muted">Premium learning platform</div>
    </div>

    <div class="footCol">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footCol muted">
      <div>Email: <a href="mailto:<%= _emailHref %>"><%= _email %></a></div>
      <div>&copy; <span id="y"></span> <%= _brand %></div>
    </div>
  </div>
</footer>

<script>
  document.getElementById('y').textContent = new Date().getFullYear();
</script>
